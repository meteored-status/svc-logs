{
  "extends": "@mr/core-dev/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "module": "node16",
    "moduleResolution": "node16",
    "noEmit": false,
    "outDir": "tmp/spec",
    "rootDir": ".",
    "incremental": false,
    "removeComments": false,
    "sourceMap": true,
    "types": ["node", "@mr/core-dev"]
  },
  "include": ["spec/**/*.spec.ts"],
  "exclude": ["node_modules", "output", "tmp"]
}
