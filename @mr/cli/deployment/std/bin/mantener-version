#!/bin/bash
# mantener-version RUTA
#
# Escribe en `RUTA/version.txt` y `RUTA/hash.txt` la versión que ya está desplegada del workspace, para
# volver a desplegarla sin generar imagen. Lo usa «Compilar» (compilar.sh) cuando la opción `generar` es
# «no»: ahí no hay nada que compilar, y antes se arrancaba `mrpack deploy` —con la instalación de todas
# las dependencias del monorepo por delante— solo para escribir estos dos ficheros.
#
# La versión sale de las etiquetas que deja «Obtener Tags» (tags.sh): las de la imagen marcada como
# desplegada (`deployed.json`) o, con `deploy.run.latest` a `true` en el `mrpack.json` de la raíz, las de
# la última generada (`tags.json`). Es la misma regla que `getVersion()` en
# `@mr/cli/src/clases/workspace/compilar.ts`, que la sigue usando para los workspaces desactivados cuando
# sí se genera: si se cambia una, hay que cambiar la otra.
#   - Se descartan `latest`, `produccion`, `test`, `deployed_produccion` y `deployed_test`.
#   - Una etiqueta `AAAA.MM.DD-NNN…` es la versión (`AAAA.MM.DD-NNN`); cualquier otra, el hash. Si hay
#     varias, gana la última.
#   - Sin `tags.json`, o si el fichero no se puede leer o no trae versión, falla. Aquí se aparta de
#     `getVersion()`, que escribía `0000.00.00-000`: sin generar no hay imagen nueva, así que eso
#     desplegaba una imagen que no existe, y el fallo no salía hasta que «Desplegar» agotaba los 5 min
#     esperando a los pods.
#
# `_DESPLEGAR_LATEST` no cuenta, igual que cuando lo escribía `mrpack`: al `docker run` de «Compilar» no
# le llegaba (ver «Opciones del despliegue» en el README de `deployment/`).
#
# Necesita `jq` (lo instala «Descargas») y `_ENTORNO`.
set -e

RUTA="${1}"
if [[ -z "${RUTA}" || ! -d "${RUTA}" ]]; then
  echo "ERROR: mantener-version: no existe el workspace «${RUTA}»" >&2
  exit 1
fi
if [[ -z "${_ENTORNO}" ]]; then
  echo "ERROR: mantener-version: falta _ENTORNO" >&2
  exit 1
fi

if [[ $(configg .deploy.run.latest) == "true" ]]; then
  FICHERO="tags.json"
else
  FICHERO="deployed.json"
fi

ETIQUETAS='(if type == "array" then .[0] else . end)
  | (.tags? // [])
  | if type == "array" then . else [] end
  | map(select(type == "string" and (IN("latest", "produccion", "test", "deployed_produccion", "deployed_test") | not)))
  | reduce .[] as $t ({version: "", hash: ""};
      (($t | capture("^(?<fecha>[0-9]{4}\\.[0-9]{2}\\.[0-9]{2})-(?<indice>[0-9]{3,})")) // null) as $p
      | if $p == null then .hash = $t else .version = "\($p.fecha)-\($p.indice)" end)'

VERSION=""
HASH=""
if [[ -f "${RUTA}/tags.json" ]]; then
  VERSION=$(jq -r "${ETIQUETAS} | .version" "${RUTA}/${FICHERO}" 2>/dev/null) || VERSION=""
  HASH=$(jq -r "${ETIQUETAS} | .hash" "${RUTA}/${FICHERO}" 2>/dev/null) || HASH=""
fi
if [[ -z "${VERSION}" ]]; then
  echo "ERROR: ${RUTA}: no hay versión desplegada en ${FICHERO}, y sin generar no hay imagen nueva que desplegar" >&2
  exit 1
fi

printf '%s' "${VERSION}-${_ENTORNO}" > "${RUTA}/version.txt"
printf '%s' "${HASH}" > "${RUTA}/hash.txt"
echo "${RUTA}: Versión ${VERSION}-${_ENTORNO} mantenida (${FICHERO})"
