    "tipo": "root"
  },
  "main": "bin/mrpack.js",
  "exports": {},
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "@inquirer/prompts": "^8.7.2",
    "chokidar": "^5.0.0",
    "dd-trace": "^6.18.0",
    "dotenv": "^18.0.4",
    "js-yaml": "^5.4.2",
    "jszip": "^3.10.2",
    "mysql2": "^3.24.5",
    "source-map-support": "^0.5.21",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@mr/core-cli": "workspace:*",
    "@mr/core-dev": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.0",
    "@types/source-map-support": "^0.5.10",
    "esbuild": "^0.28.2",
    "node-diff3": "^3.2.1",
    "services-comun": "workspace:*",
