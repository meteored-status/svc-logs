{
  "name": "@mr/cli",
  "description": "Herramientas de linea de comandos de MR{FW}",
  "author": "José Antonio Jiménez",
  "scripts": {
    "mrlang": "yarn workspace @mr/cli node --no-warnings bin/mrlang",
    "mrpack": "yarn workspace @mr/cli node --no-warnings bin/mrpack",
    "compile": "yarn rspack --config src/rspack.config.mjs"
  },
  "bin": {
    "mrlang": "bin/mrlang.js",
    "mrpack": "bin/mrpack.js"
  },
  "config": {
    "bucket": "meteored-yarn-packages",
    "subible": true,
    "tipo": "root"
  },
  "main": "bin/mrpack.js",
  "exports": {},
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@inquirer/prompts": "^8.5.0",
    "chokidar": "^5.0.0",
    "dd-trace": "^5.104.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "mysql2": "^3.22.3",
    "source-map-support": "^0.5.21",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@mr/core-dev": "workspace:*",
    "@mr/core-i18n": "workspace:*",
    "@rspack/cli": "^2.0.4",
    "@rspack/core": "^2.0.4",
    "@types/diff3": "^0.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.4",
    "@types/source-map-support": "^0.5.10",
    "diff3": "^0.0.4",
    "services-comun": "workspace:*",
    "ts-checker-rspack-plugin": "^1.3.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "version": "2026.5.27+2-josantoniojimnez"
}
